# Variables de BUILD production (npm run build).
# NB : .env.local (dev, non versionné) n'existe pas sur un serveur de build
# propre issu de git, donc CES valeurs s'appliquent au build de prod.

# On parle à notre backend (plus de mode maquette).
VITE_USE_API=true

# URL PUBLIQUE de l'API (sous-domaine + HTTPS). Adapter.
VITE_API_BASE_URL=https://api.coastalfuturesafrica.org

# Google Sheets désactivé (contacts/newsletter gérés par le backend).
VITE_SHEETS_URL=
