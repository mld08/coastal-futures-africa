# Bascule vers un vrai backend HTTP.
# Laisser vide (ou absent) pour la démo : stockage localStorage + seed JSON.
#
# Pour brancher l'API plus tard :
# VITE_USE_API=true
# VITE_API_BASE_URL=https://api.coastalfutures.exemple.org

VITE_USE_API=false
VITE_API_BASE_URL=

# Collecte Newsletter + Contact dans Google Sheets (sans backend).
# URL « .../exec » du Web App Apps Script — voir google-apps-script/Code.gs.
# Une seule URL pour les deux formulaires (routage par onglet côté script).
# Vide = données stockées uniquement en localStorage (démo).
VITE_SHEETS_URL=
