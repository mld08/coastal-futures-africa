# Coastal Futures — backend Flask : variables d'environnement
# Copier ce fichier en `.env` (non versionné) et adapter.

# Clé de signature des cookies de session. OBLIGATOIRE en prod.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-a-changer-en-production

# Base de données.
#  - Dev  : laisser vide -> SQLite local (instance/coastal_futures.db)
#  - Prod : URL PostgreSQL, ex. postgresql+psycopg2://user:pass@host:5432/coastal
DATABASE_URL=

# Origine(s) autorisée(s) pour CORS (le front Vite). Séparer par des virgules.
# Dev Vite : http://localhost:5173  |  Preview : http://localhost:4173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Cookies de session sécurisés (Secure) : true en prod (HTTPS), false en dev HTTP.
SESSION_COOKIE_SECURE=false

# SameSite du cookie de session. Front et API même site -> Lax.
# Front et API sur domaines différents (cross-site) + HTTPS -> None (impose Secure=true).
SESSION_COOKIE_SAMESITE=Lax

# Amorcer la base avec les données de démonstration du frontend au premier init.
SEED_ON_INIT=true

# --- E-mail (OTP 2FA, réinitialisation, vérification) ---
# Laisser MAIL_SERVER vide en dev : les e-mails sont écrits dans instance/outbox/
# (on peut y lire le code OTP / le lien). En prod, renseigner le SMTP :
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Coastal Futures <no-reply@coastalfutures.exemple.org>

# URL du frontend (liens des e-mails : reset, vérification).
FRONTEND_URL=http://localhost:5173

# Adresse notifiée quand quelqu'un nous contacte (formulaire de contact).
ADMIN_NOTIFY_EMAIL=contact@africagovernanceinstitute.org

# 2FA e-mail : validité du code (min) et essais max.
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
