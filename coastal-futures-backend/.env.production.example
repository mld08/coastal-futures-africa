# ============================================================================
# Coastal Futures — configuration PRODUCTION (VPS Docker).
# Copier en `.env.production` sur le VPS et remplir. NE JAMAIS versionner.
# ============================================================================

# --- Sécurité ---------------------------------------------------------------
# Clé de signature des cookies de session. OBLIGATOIRE, unique, secrète.
# Générer :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_64_HEX

# --- Base de données (PostgreSQL du conteneur `db`) -------------------------
# L'hôte est `db` (nom du service Docker Compose), le port 5432 interne.
POSTGRES_DB=coastal
POSTGRES_USER=cfuser
POSTGRES_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT
DATABASE_URL=postgresql+psycopg2://cfuser:REMPLACER_PAR_MOT_DE_PASSE_FORT@db:5432/coastal

# --- Front / CORS / Cookies -------------------------------------------------
# Origine EXACTE du frontend (protocole + domaine, sans slash final).
CORS_ORIGINS=https://coastalfuturesafrica.org
FRONTEND_URL=https://coastalfuturesafrica.org

# Cookies : HTTPS obligatoire en prod.
SESSION_COOKIE_SECURE=true
# SameSite :
#   - Front et API sous le MÊME domaine racine (ex. app + api.coastalfutures.org)
#     -> Lax (recommandé, le plus sûr).
#   - Front et API sur des domaines DIFFÉRENTS (ex. front Vercel + api perso)
#     -> None  (impose Secure=true et CORS credentials, déjà gérés).
SESSION_COOKIE_SAMESITE=Lax

# --- E-mail (2FA OTP, réinitialisation, vérification, notif contact) --------
# Renseigner un vrai SMTP en prod. Sans SMTP, les e-mails sont écrits dans
# instance/outbox/ (utile pour tester, PAS pour la prod).
MAIL_SERVER=smtp.votre-fournisseur.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=no-reply@coastalfuturesafrica.org
MAIL_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_SMTP
MAIL_FROM=Coastal Futures <no-reply@coastalfuturesafrica.org>

# Adresse notifiée quand quelqu'un utilise le formulaire de contact.
ADMIN_NOTIFY_EMAIL=contact@africagovernanceinstitute.org

# 2FA e-mail : durée de validité du code (min) et essais max.
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# --- Divers -----------------------------------------------------------------
# Amorcer les données de démo au tout premier démarrage (puis repasser à false).
SEED_ON_START=false
SEED_ON_INIT=false
